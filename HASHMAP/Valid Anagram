class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length() == t.length()){
            char[] charss = s.toCharArray();
            char[] charst = t.toCharArray();
            Arrays.sort(charss);
            Arrays.sort(charst);
            return Arrays.equals(charss, charst);
        }
        return  false;
    }
}
