class Solution {
    public void countWords(String str) {
        if (str == null || str.isEmpty()) {
            System.out.print("Number of words are 0");
            System.out.println();
            return;
        }
        int n = str.length();
        int spaces = 0;
        for (int i = 0; i < n; i++) {
            if (str.charAt(i) == ' ') {
                spaces = spaces + 1;
            }
        }
        int wordCount = spaces + 1;
        System.out.print("Number of words are ");
        System.out.print(wordCount);
        System.out.println();
    }
}
