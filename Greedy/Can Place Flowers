class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
        int l=flowerbed.length;
        int i=1;
        if(l==1){
            if(flowerbed[0] == 0){
                n--;
                return n<=0;
            }
        }
        if(flowerbed[0]==0 && flowerbed[1] == 0){
            n--;
            i +=1;
            flowerbed[0] = 1;
        }
        if(flowerbed[l-1] == 0 && flowerbed[l-2] == 0){
            n--;
            flowerbed[l-1] = 1;
        }
        while(i<l-1){
            if( flowerbed[i] == 0 &&  flowerbed[i-1] != 1 &&  flowerbed[i+1] != 1){
                flowerbed[i] = 1;
                i +=2;
                n--;
            }else{
                i++;
            }
        }
        return n<=0;
    }
}
