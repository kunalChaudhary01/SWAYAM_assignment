class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        int[] arr = new int[nums1.length];
        Stack<Integer> s = new Stack<>();
        int l1 = nums1.length;
        int l2 = nums2.length;
        for(int i = l2-1;i>=0;i--){
            while(!s.isEmpty() && nums2[s.peek()] <= nums2[i]){
                s.pop();
            }
            if(s.isEmpty()){
                arr[i] = -1;
            }else{
                arr[i] = nums2[s.peek()];
            }
            s.push(i);
        }return arr;
        
    }
}
