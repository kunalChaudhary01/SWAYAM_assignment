class Solution {
    public int evaluatePostfix(String[] arr) {
        Stack<Integer> s = new Stack<>();
        for(String ch : arr ){
            if(ch.equals("*") || ch.equals("+") || ch.equals("-") || ch.equals("/") || ch.equals("^")){
                int a = s.pop();
                int b = s.pop();
                switch(ch){
                    case "+":{
                        s.push(b+a);
                        break;
                    }
                    case "*":{
                        s.push(b*a);
                        break;
                    }
                    case "-":{
                        s.push(b-a);
                        break;
                    }
                    case "/":{
                        s.push((int)Math.floor((double)b / a));
                        break;
                    }
                    case "^":{
                        s.push((int)Math.pow(b, a));
                        break;
                    }
                }
            }else{
                s.push(Integer.parseInt(ch));
            }
        }
        return s.pop();
    }
}
