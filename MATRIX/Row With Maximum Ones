class Solution {
    public int[] rowAndMaximumOnes(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;
        int ans[] = new int[2];
        Arrays.fill(ans,0);
        for(int i=0;i<n;i++){
            int sum = 0;
            for(int j=0;j<m;j++){
                sum += mat[i][j];
            }
            if(ans[1] < sum){
                ans[0] = i;
                ans[1] = sum;
            }
        }
        return ans;
    }
}
