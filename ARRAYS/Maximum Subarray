import java.util.*;
class Solution {
    public int maxSubArray(int[] nums) {
        int currsum =0;
        int maxsum = Integer.MIN_VALUE;
        int l = nums.length;
        for(int i=0;i<l;i++){
            currsum = currsum + nums[i];
            maxsum = Math.max(currsum,maxsum);
            if(currsum<0){
                currsum = 0;
            }
        } 
        return maxsum; 
    } 
}
