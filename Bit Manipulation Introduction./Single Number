class Solution {
    public int singleNumber(int[] nums) {
        Arrays.sort(nums);
        int count = 1;
        int n=nums.length;
        for(int i=1;i<n;i++){
            if(nums[i] == nums[i-1]){
                count++;
            }else{
                if(count == 1){
                    return nums[i-1];
                }
                count = 1;
            }
        }
        if(count == 1){
            return nums[n-1];
        }
        return -1;
    }
}
